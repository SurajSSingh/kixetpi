  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "vm:probe": "deno run --allow-read=. --allow-write=. --allow-run=limactl,curl,shasum vm-tests/run.ts",
